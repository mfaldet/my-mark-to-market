# Do not set NODE_ENV here or in your host's settings. `next dev` and
# `next build` set it themselves, and forcing "development" makes a
# production build fail with "NextRouter was not mounted".

DATABASE_URL='postgresql://fatebook:postgres@localhost:5432/fatebook_development'
DATABASE_DIRECT_URL='postgresql://fatebook:postgres@localhost:5432/fatebook_development'

# Shared public developer Google OAuth credentials
GOOGLE_CLIENT_ID="639012774703-5ahl1vhme3tvdvfpjcc9jlppaj2ofv09.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="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"

GOOGLE_REDIRECT_URL="https://localhost:3000"

NEXTAUTH_URL="https://localhost:3000/api/auth"

HOST_URL="https://localhost:3000"

# The public address of your deployment, e.g. https://claims.example.com
# Every link the app builds (pages, emails, API docs) uses this.
# Leave blank locally: the app falls back to HOST_URL.
NEXT_PUBLIC_BASE_URL=

# Optional. Address reminder emails are sent from, and where replies go.
# Defaults to reminders@<your address>.
EMAIL_FROM=
EMAIL_REPLY_TO=

SECRET="wANE7Icpj3LMdASk5cq1zhIUAjqHOrl/0WFGeF+zuPw="


# --- Switch-off features (see lib/features.ts) ---
# Fatebook's team and community features are OFF in this fork.
# Set any of these to "true" to bring that feature back.
NEXT_PUBLIC_ENABLE_SLACK=
NEXT_PUBLIC_ENABLE_DISCORD=
NEXT_PUBLIC_ENABLE_EXTENSION=
NEXT_PUBLIC_ENABLE_TOURNAMENTS=
NEXT_PUBLIC_ENABLE_TEAMS=
NEXT_PUBLIC_ENABLE_PUBLIC_FEED=
NEXT_PUBLIC_ENABLE_SAGE_PAGES=
NEXT_PUBLIC_ENABLE_SAGE_EMAILS=
NEXT_PUBLIC_ENABLE_ANALYTICS=
NEXT_PUBLIC_ENABLE_FEEDBACK=
NEXT_PUBLIC_ENABLE_CLASSIC_FORM=
NEXT_PUBLIC_ENABLE_FULL_DAILY_JOB=

# --- The AI step (see lib/claims/extract.ts) ---
# Optional. With a key, Claude picks the claim shape and fills in the parts
# it can read from your text. Without one the app works the same and you
# fill the fields by hand.
ANTHROPIC_API_KEY=
# Optional. Defaults to a small, cheap model (claude-haiku-5-5).
CLAIM_AI_MODEL=

# --- The MCP server (see docs/connect-claude.md) ---
# Leave blank unless your Claude account cannot send a request header to a
# custom connector. "true" lets the API key be given in the connector
# address (/api/mcp?key=...), which can end up in logs.
MCP_ALLOW_URL_KEY=

# --- The daily job (see vercel.json and lib/cron_auth.ts) ---
# Once a day Vercel calls /api/check_for_message_updates, which adds a
# "ready to resolve" note to the notification bell for each claim whose
# deadline has passed. Vercel sends this value as a bearer token; without
# it the job is refused. Use any long random string.
CRON_SECRET=
